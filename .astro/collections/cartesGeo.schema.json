{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "feuille": {
      "type": "object",
      "properties": {
        "sud": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "ouest": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "nord": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "est": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "required": [
        "sud",
        "ouest",
        "nord",
        "est"
      ]
    },
    "contour": {
      "minItems": 3,
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "number"
          },
          {
            "type": "number"
          }
        ]
      }
    },
    "rotation": {
      "default": 0,
      "anyOf": [
        {
          "type": "number",
          "const": 0
        },
        {
          "type": "number",
          "const": 90
        },
        {
          "type": "number",
          "const": 180
        },
        {
          "type": "number",
          "const": 270
        }
      ]
    },
    "source": {
      "type": "string"
    },
    "caleLe": {
      "type": "string",
      "format": "date-time"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "feuille",
    "contour"
  ]
}