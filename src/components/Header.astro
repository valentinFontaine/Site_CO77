---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

const links = [
	{ href: '/', label: 'Accueil', kind: 'depart' },
	{ href: '/la-co/', label: 'La CO', kind: 'poste' },
	{ href: '/actualites/', label: 'Actualités', kind: 'poste' },
	{ href: '/organisation/', label: 'Notre organisation', kind: 'poste' },
	{ href: '/cartographie/', label: 'Cartographie', kind: 'poste' },
	{ href: '/missions-cd/', label: 'Missions du CD', kind: 'poste' },
	{ href: '/la-co/les-clubs/', label: 'Arrivée : trouver un club', kind: 'arrivee' },
];
---

<header>
	<nav>
		<a href="/" class="logo-link">
			<img src="/logo-cdco77.svg" alt={SITE_TITLE} class="logo" width="295" height="376" />
			<span class="logo-text">
				<strong>CDCO 77</strong>
				<span>Course d'orientation en Seine-et-Marne</span>
			</span>
		</a>
		<!--
			Les repères (triangle, cercles, double cercle) ne s'affichent qu'avec la
			mise en forme Parcours : le menu devient un circuit, du départ à l'arrivée.
			data-step relie chaque entrée au poste de l'accueil (Parcours.astro).
		-->
		<div class="internal-links">
			{
				links.map((link, i) => (
					<HeaderLink href={link.href} data-step={i} class={link.kind === 'arrivee' ? 'nav-arrivee' : undefined}>
						<svg class="nav-repere" viewBox="0 0 40 40" aria-hidden="true">
							{link.kind === 'depart' && <polygon points="20,7 33,30 7,30" />}
							{link.kind === 'poste' && <circle cx="20" cy="20" r="13" />}
							{link.kind === 'arrivee' && (
								<>
									<circle cx="20" cy="20" r="15" />
									<circle cx="20" cy="20" r="9" />
								</>
							)}
						</svg>
						{link.kind === 'poste' && <span class="nav-numero">{i}</span>}
						<span class="nav-label">{link.label}</span>
					</HeaderLink>
				))
			}
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	.logo {
		display: block;
		height: 48px;
		width: auto;
	}
	/* Le nom à côté du logo n'apparaît qu'avec la mise en forme Flyer (themes.css) */
	.logo-text {
		display: none;
	}
	.logo-link {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.6em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	/* Repères du circuit : mise en forme Parcours seulement (themes.css) */
	.nav-repere,
	.nav-numero {
		display: none;
	}
	.logo-link:hover {
		border-bottom-color: var(--accent);
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>
