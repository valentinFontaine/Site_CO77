---
import { getPublished } from '../../lib/collections';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';

const maps = await getPublished('cartes');

// Trier par secteur puis par nom, pour une liste stable et lisible.
const cartes = maps.sort((a, b) =>
	`${a.data.region ?? ''} ${a.data.title}`.localeCompare(`${b.data.region ?? ''} ${b.data.title}`, 'fr'),
);

// Données transmises telles quelles au script Leaflet. L'adresse de la fiche est
// calculée ici plutôt que reconstruite en JavaScript, pour rester cohérente avec
// les pages réellement générées par [...slug].astro.
const mapData = cartes.map((carte) => ({
	title: carte.data.title,
	bounds: carte.data.bounds,
	thumbnail: carte.data.thumbnail,
	mapType: carte.data.mapType,
	scale: carte.data.scale,
	difficultyLevel: carte.data.difficultyLevel,
	url: `/cartographie/${carte.id}/`,
}));
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead
			title="Cartographie"
			description="Les cartes de course d'orientation de Seine-et-Marne : emprises, échelles et secteurs, sur une carte interactive."
		/>
		<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
	</head>
	<body>
		<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>

		<Header />

		<main>
			<h1>Cartographie en Seine-et-Marne</h1>
			<p class="intro">
				Chaque rectangle représente l'emprise d'une carte. Survolez-le pour voir ses caractéristiques,
				cliquez pour ouvrir sa fiche.
			</p>

			<div id="map" data-map-data={JSON.stringify(mapData)}></div>

			<p class="legende">
				<span class="puce" style="--couleur: #1b7f3b"></span> Forêt
				<span class="puce" style="--couleur: #b3541e"></span> Urbain
				<span class="puce" style="--couleur: #7b2ff7"></span> Sprint
				<span class="puce" style="--couleur: #0f6d8f"></span> Mixte
			</p>

			<h2>Les cartes disponibles</h2>
			{
				cartes.length === 0 ? (
					<p>Aucune carte n'est publiée pour le moment.</p>
				) : (
					<ul class="liste-cartes">
						{cartes.map((carte) => (
							<li>
								<a href={`/cartographie/${carte.id}/`}>{carte.data.title}</a>
								<span class="meta">
									{[carte.data.region, carte.data.mapType, carte.data.scale, carte.data.difficultyLevel]
										.filter(Boolean)
										.join(' · ')}
								</span>
							</li>
						))}
					</ul>
				)
			}

			<h2>Acheter des cartes</h2>
			<p>
				Après avoir consulté l'inventaire des cartes du CDCO77, adressez-vous directement au
				propriétaire de la carte.
			</p>
			<div class="encadre">
				<h3>Cartes appartenant au CDCO77</h3>
				<p>Prendre contact auprès du responsable cartographique :</p>
				<p>
					<strong>Etienne Morey</strong><br />
					06 07 43 21 97<br />
					<a href="mailto:etienne.morey@neuf.fr">etienne.morey@neuf.fr</a>
				</p>
			</div>
			<p>
				L'inventaire complet est également consultable sur le site de la fédération :
				<a
					href="https://www.ffcorientation.fr/licencie/cartographie/cartotheque/liste/?cd=77"
					target="_blank"
					rel="noopener noreferrer">cartothèque FFCO — département 77</a
				>.
			</p>

			<h2>Ressources pour les clubs</h2>
			<p>Outils à destination des clubs affiliés au CDCO77 pour créer et partager des cartes.</p>
			<ul>
				<li>
					<a
						href="https://drive.google.com/drive/folders/1cnnNO6GYUxPZ3dVjsCl1UCVYkunPvPmG?usp=sharing"
						target="_blank"
						rel="noopener noreferrer">Dossier de partage des cartes</a
					>
				</li>
			</ul>
			<div class="encadre">
				<h3>Déclaration des nouvelles cartes</h3>
				<p>
					Pensez à déclarer vos nouvelles cartes auprès de la FFCO et de la LIFCO selon la procédure
					en vigueur.
				</p>
			</div>
		</main>

		<Footer />

		<script is:inline src="/scripts/map-init.js"></script>

		<style>
			/* Cette page a besoin de plus de largeur que le reste du site pour la carte. */
			main {
				width: 1100px;
			}
			.intro {
				color: rgb(var(--gray));
			}
			#map {
				height: 600px;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
				z-index: 0;
			}
			@media (max-width: 720px) {
				#map {
					height: 380px;
				}
			}
			.legende {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.4em 1.2em;
				margin-top: 1em;
				font-size: 0.85em;
				color: rgb(var(--gray));
			}
			.puce {
				display: inline-block;
				width: 0.9em;
				height: 0.9em;
				margin-right: 0.2em;
				border: 2px solid var(--couleur);
				border-radius: 3px;
				background: color-mix(in srgb, var(--couleur) 25%, transparent);
				vertical-align: -0.1em;
			}
			.liste-cartes {
				list-style: none;
				padding: 0;
			}
			.liste-cartes li {
				padding: 0.6em 0;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.liste-cartes .meta {
				display: block;
				font-size: 0.8em;
				color: rgb(var(--gray));
			}
			.encadre {
				margin: 1.5em 0;
				padding: 1em 1.5em;
				border-left: 4px solid var(--accent);
				background: rgba(var(--gray-light), 40%);
				border-radius: 0 8px 8px 0;
			}
			.encadre h3 {
				font-size: 1.2em;
			}
			.encadre p:last-child {
				margin-bottom: 0;
			}
		</style>

		<style is:global>
			.custom-tooltip {
				font-family: var(--font-atkinson);
				font-size: 14px;
				line-height: 1.4;
			}
			.custom-tooltip .infobulle-details {
				color: #4b5563;
			}
			.carte-emprise {
				cursor: pointer;
				transition: fill-opacity 0.15s ease;
			}
			.map-image-overlay {
				pointer-events: none;
			}
		</style>
	</body>
</html>
