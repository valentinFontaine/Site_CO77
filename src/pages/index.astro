---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getPublished } from '../lib/collections';
import FormattedDate from '../components/FormattedDate.astro';

const allActualites = (await getPublished('actualites')).map(p => ({ ...p, collection: 'actualites' }));
const allClubs = (await getPublished('clubs')).map(p => ({ ...p, collection: 'clubs' }));
const allCartes = (await getPublished('cartes')).map(p => ({ ...p, collection: 'cartes' }));
const allEntrainements = (await getPublished('entrainements')).map(p => ({ ...p, collection: 'entrainements' }));
const allEvenements = (await getPublished('evenements')).map(p => ({ ...p, collection: 'evenements' }));

const allContent = [...allActualites, ...allClubs, ...allCartes, ...allEntrainements, ...allEvenements];

function getCollectionPath(collection) {
  switch (collection) {
    case 'actualites': return '/actualites';
    case 'clubs': return '/la-co/les-clubs';
    case 'cartes': return '/cartographie';
    case 'entrainements': return '/missions-cd/entrainements';
    case 'evenements': return '/evenements';
    default: return '';
  }
}

const recentContent = allContent
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<!-- Bandeau du flyer « On filme », visible seulement avec cette mise en forme (themes.css) -->
		<section class="hero-flyer" aria-labelledby="hero-flyer-title">
			<!-- Photo et cercle partagent le même repère : le cercle reste sur la balise quel que soit le recadrage -->
			<svg class="hero-flyer__photo" viewBox="0 0 1920 1080" preserveAspectRatio="xMaxYMid slice" aria-hidden="true">
				<defs>
					<linearGradient id="hero-flyer-voile" x1="0" x2="1" y1="0" y2="0">
						<stop offset="0" stop-color="#14362a" stop-opacity="0.85" />
						<stop offset="0.55" stop-color="#1e4a3a" stop-opacity="0.55" />
						<stop offset="1" stop-color="#1e4a3a" stop-opacity="0.2" />
					</linearGradient>
				</defs>
				<image href="/images/bandeau-accueil.jpg" width="1920" height="1080" />
				<rect width="1920" height="1080" fill="url(#hero-flyer-voile)" />
				<circle cx="1368" cy="541" r="165" fill="none" stroke="#f15a22" stroke-width="7" />
			</svg>
			<div class="hero-flyer__content">
				<p class="hero-flyer__kicker">Course d'orientation · Seine-et-Marne</p>
				<p class="hero-flyer__tag">Comité départemental 77</p>
				<h1 id="hero-flyer-title">Lis la carte.<br /><span>Trouve la balise.</span></h1>
				<p class="hero-flyer__text">
					Découvrez les activités, les clubs, les entraînements et les compétitions
					de course d'orientation dans le département de Seine-et-Marne.
				</p>
			</div>
		</section>
		<main>
			<div class="home-intro">
				<h1>Bienvenue sur le site du CO77</h1>
				<p>
					Bienvenue sur le site officiel du <strong>Comité Départemental 77 de Course d'Orientation</strong>.
				</p>
				<p>
					Découvrez les activités, les clubs, les entraînements et les compétitions de course d'orientation 
					dans le département de Seine-et-Marne.
				</p>
			</div>
			
			<h2>Nos sections</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; margin: 2rem 0;">
				<div style="border: 1px solid #ddd; padding: 1.5rem; border-radius: 8px;">
					<h3>La CO</h3>
					<p>Découvrez la course d'orientation et ses différentes facettes.</p>
					<a href="/la-co/" style="color: var(--accent);">En savoir plus →</a>
				</div>
				<div style="border: 1px solid #ddd; padding: 1.5rem; border-radius: 8px;">
					<h3>Actualités</h3>
					<p>Résultats, news, photos et portraits des orienteurs.</p>
					<a href="/actualites/" style="color: var(--accent);">En savoir plus →</a>
				</div>
				<div style="border: 1px solid #ddd; padding: 1.5rem; border-radius: 8px;">
					<h3>Cartographie</h3>
					<p>Nos cartes et parcours d'orientation.</p>
					<a href="/cartographie/" style="color: var(--accent);">En savoir plus →</a>
				</div>
				<div style="border: 1px solid #ddd; padding: 1.5rem; border-radius: 8px;">
					<h3>Missions du CD</h3>
					<p>Entraînements, matériel et organisation.</p>
					<a href="/missions-cd/" style="color: var(--accent);">En savoir plus →</a>
				</div>
			</div>

			<h2>Dernières publications</h2>
			<ul style="list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; margin: 1.5rem 0;">
				{recentContent.map((post) => {
					const collectionPath = getCollectionPath(post.collection);
					return (
						<li style="border: 1px solid #ddd; padding: 1rem; border-radius: 8px;">
							<h3 style="margin-top: 0;">{post.data.title || post.data.name}</h3>
							<p style="color: var(--gray); font-size: 0.875rem; margin: 0.5rem 0;"><FormattedDate date={post.data.pubDate} /></p>
							<a href={`${collectionPath}/${post.id}/`} style="display: inline-block; margin-top: 0.5rem; padding: 0.5rem 1rem; background: var(--accent); color: white; border-radius: 4px; text-decoration: none;">Lire la suite →</a>
						</li>
					);
				})}
			</ul>
		</main>
		<Footer />
	</body>
</html>
